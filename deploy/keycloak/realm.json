{
  "realm": "gedour-test",
  "displayName": "gedour test realm",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "gedour",
      "name": "gedour",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "gedour-test-secret",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:${GEDOUR_E2E_PORT}/auth/callback", "http://localhost:8082/auth/callback"],
      "webOrigins": ["http://localhost:${GEDOUR_E2E_PORT}", "http://localhost:8082"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:${GEDOUR_E2E_PORT}/auth/signed-out##http://localhost:8082/auth/signed-out"
      },
      "protocolMappers": [
        {
          "name": "roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-client-role-mapper",
          "consentRequired": false,
          "config": {
            "usermodel.clientRoleMapping.clientId": "gedour",
            "claim.name": "roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "false"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@example.test",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Liddell",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }],
      "clientRoles": {
        "gedour": ["gedour-user", "gedour-admin"]
      }
    },
    {
      "username": "bob",
      "email": "bob@example.test",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Builder",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }],
      "clientRoles": {
        "gedour": ["gedour-user"]
      }
    },
    {
      "username": "carol",
      "email": "carol@example.test",
      "emailVerified": true,
      "firstName": "Carol",
      "lastName": "Nora",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "carol", "temporary": false }]
    },
    {
      "username": "dave",
      "email": "dave@example.test",
      "emailVerified": true,
      "firstName": "Dave",
      "lastName": "Purged",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "dave", "temporary": false }],
      "clientRoles": { "gedour": ["gedour-user"] }
    },
    {
      "username": "erin",
      "email": "erin@example.test",
      "emailVerified": true,
      "firstName": "Erin",
      "lastName": "Fleet",
      "enabled": true,
      "credentials": [{ "type": "password", "value": "erin", "temporary": false }],
      "clientRoles": { "gedour": ["gedour-user"] }
    }
  ],
  "roles": {
    "client": {
      "gedour": [
        { "name": "gedour-user", "description": "May sign in to gedour" },
        { "name": "gedour-admin", "description": "Administers gedour" }
      ]
    }
  }
}
