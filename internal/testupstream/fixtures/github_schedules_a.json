  "files": {
    ".github/workflows/mirror.yml": "name: Mirror\n\non:\n  schedule:\n    - cron: '0 3 1 1 *'\n  workflow_dispatch:\n\njobs:\n  mirror:\n    runs-on: ubuntu-latest\n    steps:\n      - run: ./scripts/mirror.sh\n",
    ".github/workflows/yearly.yml": "name: Yearly report\n\non:\n  schedule:\n    - cron: '0 1 1 1 *'\n      timezone: \"Europe/Paris\"\n\njobs:\n  report:\n    runs-on: ubuntu-latest\n    steps:\n      - run: ./scripts/report.sh\n",
    ".github/workflows/ci.yml": "name: CI\n\non:\n  push:\n    branches: [main]\n  pull_request:\n\njobs:\n  test:\n    runs-on: ubuntu-latest\n    steps:\n      - run: make test\n",
    ".github/workflows/lint.yml": "name: Lint\non: [push, pull_request]\njobs:\n  lint:\n    runs-on: ubuntu-latest\n    steps:\n      - run: make lint\n"
